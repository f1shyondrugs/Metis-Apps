{
  "name": "metis-ai-remote-client",
  "version": "1.7.12",
  "private": true,
  "description": "Metis desktop app with integrated device connection",
  "main": "main.cjs",
  "author": "f1shyondrugs",
  "license": "MIT",
  "scripts": {
    "prepare:client": "node prepare-client.cjs",
    "start": "npm run prepare:client && electron .",
    "build:win": "npm run prepare:client && electron-builder --win nsis --x64",
    "build:mac": "npm run prepare:client && electron-builder --mac --arm64",
    "build:linux": "npm run prepare:client && electron-builder --linux AppImage --x64 --config.npmRebuild=false",
    "build:dir": "npm run prepare:client && electron-builder --dir",
    "pretest": "node -e \"require('electron')\"",
    "test": "npm run prepare:client && node --test ../tests/*.test.mjs tests/policy.test.cjs tests/reopen.test.cjs tests/assistant-toggle.test.cjs tests/assistant-regions.test.cjs tests/assistant-shortcuts.test.cjs tests/web-permissions.test.cjs",
    "check": "node scripts/check.cjs",
    "test:e2e": "electron tests/native-modules.cjs && electron tests/smoke.cjs && electron tests/unified.cjs && electron tests/assistant.cjs && electron tests/voice-permissions.cjs",
    "generate:icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "koffi": "^2.16.3",
    "uiohook-napi": "1.5.5",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.0.12",
    "png-to-ico": "3.0.2",
    "sharp": "0.35.5"
  },
  "build": {
    "appId": "ai.metis.remoteclient",
    "productName": "Metis",
    "asar": true,
    "afterPack": "build/linux-after-pack.cjs",
    "asarUnpack": [
      "computer-use-worker.mjs",
      "computer-use.mjs",
      "computer-use-unix.mjs",
      "libmetisdesktop.dylib",
      "**/node_modules/koffi/**",
      "**/node_modules/uiohook-napi/**"
    ],
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "renderer.js",
      "command-history.cjs",
      "styles.css",
      "client.mjs",
      "computer-use.mjs",
      "computer-use-worker.mjs",
      "computer-use-unix.mjs",
      "computer-use-overlay.cjs",
      "appearance.cjs",
      "cancel-shortcut.cjs",
      "assistant-shortcuts.cjs",
      "overlay-preferences.cjs",
      "libmetisdesktop.dylib",
      "assets/icon.ico",
      "assets/icon.png",
      "assets/brand.png",
      "assets/lucide-LICENSE.txt",
      "node_modules/**/*",
      "package.json",
      "credential-store.cjs",
      "platform.cjs",
      "notification-client.mjs",
      "notification-native.cjs",
      "src/main/**/*",
      "src/device/runtime*.cjs",
      "LICENSE",
      "policy.cjs",
      "ui/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "executableName": "Metis AI Remote Client"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/uninstall.nsh",
      "artifactName": "Metis-AI-Remote-Client-Setup.exe",
      "shortcutName": "Metis",
      "uninstallDisplayName": "Metis"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "artifactName": "Metis-AI-Remote-Client-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Metis uses the microphone for voice input.",
        "NSCameraUsageDescription": "Metis uses the camera when you explicitly grant access."
      }
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "artifactName": "Metis-AI-Remote-Client-x86_64.AppImage"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "f1shyondrugs",
        "repo": "Metis-Apps"
      }
    ]
  }
}
